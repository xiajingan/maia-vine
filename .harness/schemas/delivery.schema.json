{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mai.local/harness/delivery.schema.json",
  "type": "object",
  "required": ["schema_version", "delivery_id", "assignment_id", "assignment_digest", "project_id", "source_commit", "artifacts", "quality", "manifest_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "delivery_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "assignment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "assignment_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "source_commit": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "ref", "signature", "sbom", "build_once_evidence", "built_at", "rollback_version"],
        "properties": {
          "type": {"enum": ["oci-image", "helm-chart", "client-package", "dependency-package"]},
          "ref": {"type": "string", "minLength": 1, "not": {"pattern": "[lL][aA][tT][eE][sS][tT]"}},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
          "deployment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
          "version": {"type": "string", "minLength": 1},
          "package": {"type": "string", "minLength": 1},
          "signature": {"type": "string", "pattern": "^signature://[^?#]+/sha256:[0-9a-f]{64}/sha256:[0-9a-f]{64}$"},
          "sbom": {"type": "string", "pattern": "^sbom://[^?#]+/sha256:[0-9a-f]{64}/sha256:[0-9a-f]{64}$"},
          "build_once_evidence": {"type": "string", "pattern": "^build://[^?#]+/sha256:[0-9a-f]{64}/sha256:[0-9a-f]{64}$"},
          "built_at": {"type": "string", "format": "date-time"},
          "rollback_version": {"type": "string", "pattern": "^(v?\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?|sha256:[0-9a-f]{64})$"}
        },
        "allOf": [
          {"if": {"properties": {"type": {"enum": ["oci-image", "helm-chart"]}}}, "then": {"required": ["digest"]}},
          {"if": {"properties": {"type": {"const": "helm-chart"}}}, "then": {"required": ["deployment_id", "version"]}},
          {"if": {"properties": {"type": {"const": "client-package"}}}, "then": {"required": ["sha256"]}},
          {"if": {"properties": {"type": {"const": "dependency-package"}}}, "then": {"required": ["package", "version", "sha256"]}}
        ],
        "additionalProperties": true
      }
    },
    "quality": {"type": "object", "properties": {"status": {"const": "passed"}}, "required": ["status"]}
  },
  "additionalProperties": true
}
