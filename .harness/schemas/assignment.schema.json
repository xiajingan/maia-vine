{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mai.local/harness/assignment.schema.json",
  "type": "object",
  "required": ["schema_version", "assignment_id", "assignment_type", "source_project_id", "source_reference", "target_project_id", "outcome", "acceptance", "priority", "idempotency_key"],
  "properties": {
    "schema_version": {"const": 2},
    "assignment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "assignment_type": {"enum": ["product", "architecture", "dependency"]},
    "source_project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "source_reference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "target_project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "outcome": {"type": "string", "minLength": 1},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "priority": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"}
  },
  "additionalProperties": true
}
