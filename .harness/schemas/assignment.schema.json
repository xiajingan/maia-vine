{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mai.local/harness/assignment.schema.json",
  "type": "object",
  "required": ["schema_version", "assignment_id", "control_requirement_id", "target_project_id", "outcome", "acceptance", "priority", "suggested_sprint_window", "deadline", "coordination_contact", "adjustment_scope", "idempotency_key"],
  "properties": {
    "schema_version": {"const": 1},
    "assignment_id": {"type": "string"},
    "control_requirement_id": {"type": "string"},
    "target_project_id": {"type": "string"},
    "outcome": {"type": "string", "minLength": 1},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "idempotency_key": {"type": "string"}
  },
  "additionalProperties": true
}
