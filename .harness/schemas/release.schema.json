{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mai.local/harness/release.schema.json",
  "type": "object",
  "required": ["schema_version", "release_id", "status", "deliveries", "manifest_digest", "composed_by", "created_at", "dependency_order"],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "composed_by": {"const": "mai-harness"},
    "created_at": {"type": "string", "minLength": 1},
    "dependency_order": {"type": "array"},
    "status": {"enum": ["composed", "test-verifying", "test-verified", "failed", "promoted", "rolled-back"]},
    "deliveries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["manifest_digest", "artifacts"],
        "properties": {
          "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {"enum": ["oci-image", "helm-chart", "client-package"]},
                "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "deployment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
                "version": {"type": "string", "minLength": 1}
              },
              "allOf": [
                {"if": {"properties": {"type": {"enum": ["oci-image", "helm-chart"]}}}, "then": {"required": ["digest"]}},
                {"if": {"properties": {"type": {"const": "helm-chart"}}}, "then": {"required": ["deployment_id", "version"]}}
              ]
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
