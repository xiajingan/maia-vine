{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mai.local/harness/dependency-session.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "capability_id",
    "consumer_project_id",
    "consumer_sprint",
    "consumer_task_id",
    "provider_project_id",
    "provider_sprint",
    "package",
    "outcome",
    "acceptance",
    "request_digest",
    "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "capability_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "consumer_project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "consumer_sprint": {"type": "string", "pattern": "^sprint-[0-9]+-[a-z0-9][a-z0-9-]*$"},
    "consumer_task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "provider_project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "provider_sprint": {"type": "string", "pattern": "^sprint-[0-9]+-[a-z0-9][a-z0-9-]*$"},
    "package": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "minLength": 1},
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {
      "enum": ["starting", "provider-planning", "candidate-built", "consumer-verified", "completed", "failed"]
    }
  },
  "additionalProperties": true
}
